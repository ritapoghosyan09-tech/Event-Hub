// EVENT HUB — initial database schema (proposal v0.1, not yet migrated)
// PostgreSQL 16+ · Prisma ORM 7
//
// Conventions
// - IDs: cuid2 strings generated by the app (URL-safe, non-sequential, no enumeration).
// - Money: integer minor units (cents/luma) + ISO-4217 currency. Never floats.
// - Time: every timestamp is timestamptz (UTC). Events also store their IANA timezone
//   so the UI shows the venue's local time.
// - Soft state over deletes: events are CANCELLED, not deleted, once anyone has booked.
// - Auth tables (User, Session, Account, Verification) follow Better Auth's Prisma
//   adapter shape so the library can manage them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────

enum PlatformRole {
  USER
  ADMIN
}

model User {
  id             String       @id
  name           String
  email          String       @unique
  emailVerified  Boolean      @default(false)
  image          String?
  role           PlatformRole @default(USER)
  city           String? // home city for "near me" defaults; user-entered
  marketingOptIn Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  sessions      Session[]
  accounts      Account[]
  memberships   OrganizationMember[]
  bookings      Booking[]
  favorites     Favorite[]
  reviews       Review[]
  notifications NotificationLog[]
  checkIns      Ticket[]             @relation("CheckedInBy")

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String // "credential" | "google" | ...
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String? // hash only, managed by Better Auth
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────
// Organizers
// One user can belong to several organizations; an organization can have
// several team members. Covers individuals, businesses/brands and communities.
// ─────────────────────────────────────────────────────────────

enum OrganizationType {
  INDIVIDUAL
  BUSINESS
  COMMUNITY
  NONPROFIT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  STAFF // can scan tickets and view attendees, cannot edit events or payouts
}

model Organization {
  id           String             @id
  slug         String             @unique
  name         String
  type         OrganizationType
  bio          String?
  logoUrl      String?
  coverUrl     String?
  websiteUrl   String?
  contactEmail String
  verified     Boolean            @default(false)
  status       OrganizationStatus @default(ACTIVE)

  // Payments: the provider-side account that receives payouts. Provider TBD (see decisions).
  payoutProvider   String?
  payoutAccountRef String? @unique
  payoutsEnabled   Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  members OrganizationMember[]
  events  Event[]
  venues  Venue[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String
  userId         String
  role           MemberRole
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id        String  @id
  slug      String  @unique
  name      String
  iconKey   String? // maps to an icon in the design system, not a URL
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  events    Event[]

  @@map("categories")
}

model Venue {
  id             String        @id
  name           String
  addressLine1   String
  addressLine2   String?
  city           String
  region         String?
  postalCode     String?
  countryCode    String        @db.Char(2)
  latitude       Decimal       @db.Decimal(9, 6)
  longitude      Decimal       @db.Decimal(9, 6)
  timezone       String // IANA, e.g. "Asia/Yerevan"
  organizationId String? // venues are created by organizers; shared venues later
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  events         Event[]

  @@index([city])
  @@index([latitude, longitude])
  @@map("venues")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED // set by a job after endsAt
}

enum EventVisibility {
  PUBLIC
  UNLISTED // reachable by link only, hidden from discovery
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

model Event {
  id             String          @id
  slug           String          @unique
  organizationId String
  categoryId     String
  venueId        String? // null when ONLINE
  title          String
  summary        String          @db.VarChar(280) // card + SEO description
  description    String // sanitized rich text (stored as HTML or JSON — decision pending)
  format         EventFormat     @default(IN_PERSON)
  onlineUrl      String? // revealed only to ticket holders
  startsAt       DateTime        @db.Timestamptz(6)
  endsAt         DateTime        @db.Timestamptz(6)
  timezone       String
  status         EventStatus     @default(DRAFT)
  visibility     EventVisibility @default(PUBLIC)
  capacity       Int? // optional overall cap across ticket types
  ageRestriction Int?
  refundPolicy   String?

  // Denormalized for fast listing/sorting; maintained in the same transaction as ticket changes.
  minPriceMinor Int?
  currency      String? @db.Char(3)
  isFree        Boolean @default(false)

  // Featured placement (admin-curated in MVP; paid promotion later)
  featuredFrom  DateTime? @db.Timestamptz(6)
  featuredUntil DateTime? @db.Timestamptz(6)

  publishedAt  DateTime? @db.Timestamptz(6)
  cancelledAt  DateTime? @db.Timestamptz(6)
  cancelReason String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  // Full-text search column, managed by a raw SQL migration (generated tsvector + GIN index).
  searchVector Unsupported("tsvector")?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  venue        Venue?       @relation(fields: [venueId], references: [id], onDelete: Restrict)
  images       EventImage[]
  ticketTypes  TicketType[]
  bookings     Booking[]
  favorites    Favorite[]
  reviews      Review[]

  @@index([status, visibility, startsAt])
  @@index([categoryId, startsAt])
  @@index([organizationId, startsAt])
  @@index([featuredUntil])
  @@map("events")
}

model EventImage {
  id          String   @id
  eventId     String
  storageKey  String // object key in the bucket; URL is derived
  alt         String
  width       Int
  height      Int
  blurDataUrl String? // tiny placeholder for elegant loading
  isCover     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
  @@map("event_images")
}

// ─────────────────────────────────────────────────────────────
// Ticketing
// ─────────────────────────────────────────────────────────────

enum TicketTypeStatus {
  ACTIVE
  HIDDEN
  SOLD_OUT
}

model TicketType {
  id            String           @id
  eventId       String
  name          String // "General", "VIP", "Student"
  description   String?
  priceMinor    Int // 0 = free
  currency      String           @db.Char(3)
  quantityTotal Int
  quantitySold  Int              @default(0) // confirmed
  quantityHeld  Int              @default(0) // reserved by PENDING bookings, released on expiry
  minPerOrder   Int              @default(1)
  maxPerOrder   Int              @default(10)
  salesStartAt  DateTime?        @db.Timestamptz(6)
  salesEndAt    DateTime?        @db.Timestamptz(6)
  status        TicketTypeStatus @default(ACTIVE)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]
  tickets      Ticket[]

  // DB CHECK (raw migration): quantitySold + quantityHeld <= quantityTotal
  @@index([eventId, sortOrder])
  @@map("ticket_types")
}

enum BookingStatus {
  PENDING // inventory held, awaiting payment (paid) — free bookings skip straight to CONFIRMED
  CONFIRMED
  CANCELLED // by attendee or because the event was cancelled
  REFUNDED
  EXPIRED // hold timed out without payment
}

model Booking {
  id             String        @id
  code           String        @unique // short human-readable reference, e.g. "EH-7K3Q9P"
  userId         String
  eventId        String
  status         BookingStatus @default(PENDING)
  subtotalMinor  Int
  feeMinor       Int           @default(0) // buyer-facing service fee, if any
  totalMinor     Int
  currency       String        @db.Char(3)
  contactName    String
  contactEmail   String
  holdExpiresAt  DateTime?     @db.Timestamptz(6)
  confirmedAt    DateTime?     @db.Timestamptz(6)
  cancelledAt    DateTime?     @db.Timestamptz(6)
  idempotencyKey String?       @unique // from the client, prevents double submits
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items         BookingItem[]
  tickets       Ticket[]
  payments      Payment[]
  notifications NotificationLog[]
  review        Review?

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

model BookingItem {
  id             String     @id
  bookingId      String
  ticketTypeId   String
  quantity       Int
  unitPriceMinor Int // price snapshot at purchase time
  booking        Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@unique([bookingId, ticketTypeId])
  @@map("booking_items")
}

enum TicketStatus {
  VALID
  CHECKED_IN
  VOID
}

// One row per admission. Created when a booking is CONFIRMED.
model Ticket {
  id            String       @id
  bookingId     String
  ticketTypeId  String
  attendeeName  String?
  attendeeEmail String?
  qrToken       String       @unique // random, unguessable; signed payload rendered as QR
  status        TicketStatus @default(VALID)
  checkedInAt   DateTime?    @db.Timestamptz(6)
  checkedInById String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType  TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  checkedInBy User?      @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([ticketTypeId, status])
  @@map("tickets")
}

// ─────────────────────────────────────────────────────────────
// Payments (provider-agnostic)
// ─────────────────────────────────────────────────────────────

enum PaymentStatus {
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                  String        @id
  bookingId           String
  provider            String // "stripe" | local acquirer — decision pending
  providerPaymentRef  String        @unique // e.g. checkout session / payment intent id
  status              PaymentStatus
  amountMinor         Int
  currency            String        @db.Char(3)
  platformFeeMinor    Int           @default(0) // EVENT HUB commission
  refundedAmountMinor Int           @default(0)
  failureReason       String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("payments")
}

// Every incoming webhook is recorded once; processing is idempotent on (provider, providerEventId).
model WebhookEvent {
  id              String    @id
  provider        String
  providerEventId String
  type            String
  receivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)
  error           String?

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────
// Engagement
// ─────────────────────────────────────────────────────────────

model Favorite {
  userId    String
  eventId   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
  @@map("favorites")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN // moderated
}

// Only attendees with a CONFIRMED booking for a past event may review (enforced in the service layer).
model Review {
  id        String       @id
  eventId   String
  userId    String
  bookingId String       @unique
  rating    Int // 1–5, DB CHECK in raw migration
  body      String?
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("reviews")
}

enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER_24H
  REMINDER_2H
  EVENT_UPDATED
  EVENT_CANCELLED
}

// Prevents duplicate emails when a job retries; also the audit trail of what was sent.
model NotificationLog {
  id        String           @id
  userId    String
  bookingId String?
  type      NotificationType
  channel   String           @default("email")
  sentAt    DateTime         @default(now()) @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type, channel])
  @@index([userId])
  @@map("notification_logs")
}
