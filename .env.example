# EVENT HUB — environment variables (copy to .env.local; never commit real values)

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_CURRENCY=USD                # ISO-4217; pending launch-market decision
PLATFORM_FEE_BPS=0                  # commission in basis points (500 = 5%), recorded per payment; pending decision
BOOKING_HOLD_MINUTES=30           # seats held during card checkout; Stripe needs at least 30
NEXT_PUBLIC_DEMO_CONTENT=true       # shows the 'sample content' note in the footer; set false at launch

# --- Database (PostgreSQL 16+) -----------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eventhub?sslmode=require   # pooled, used by the app
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/eventhub?sslmode=require     # direct, used by migrations

# --- Authentication (Better Auth) --------------------------------------
BETTER_AUTH_SECRET=                 # 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Stripe Checkout) ------------------------------------------
# Leave empty to run without card payments: paid tickets are then reserved and paid at the venue.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # from the webhook endpoint for /api/payments/webhook
# PAYMENT_PROVIDER=test             # test suite only (also needs E2E=1)

# --- Image storage (S3-compatible, e.g. Cloudflare R2) -----------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=eventhub-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_MEDIA_BASE_URL=         # public CDN host for images

# --- Maps & geocoding ---------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_URL=          # MapLibre style JSON (includes a domain-restricted public key)
GEOCODING=on                        # venue addresses → map pins via OpenStreetMap; "off" to skip

# --- Email (Resend) ----------------------------------------------------
RESEND_API_KEY=                     # empty = emails go to MAIL_OUTBOX_FILE instead (development)
EMAIL_FROM="EVENT HUB <tickets@mail.example.com>"
MAIL_OUTBOX_FILE=.data/outbox.jsonl

# --- Scheduled jobs ------------------------------------------------------
# Call with "Authorization: Bearer $CRON_SECRET":
#   GET /api/cron/expire-holds   every 5 minutes
#   GET /api/cron/reminders      every hour
CRON_SECRET=

# --- Monitoring ---------------------------------------------------------
SENTRY_DSN=
